// Ejecuta el script de Windows para crear la VM y devuelve la IP detectada
func crearMaquinaVirtual(host string) (string, error) {
	cmd := exec.Command("cmd.exe", "/C", scriptCrearVM, host)
	var out bytes.Buffer
	cmd.Stdout = &out
	cmd.Stderr = &out

	err := cmd.Run()
	if err != nil {
		return "", fmt.Errorf("error ejecutando script: %v\nSalida: %s", err, out.String())
	}

	// Buscar línea con el formato [IP]192.168.x.x
	for _, line := range strings.Split(out.String(), "\n") {
		if strings.HasPrefix(strings.TrimSpace(line), "[IP]") {
			ip := strings.TrimSpace(strings.TrimPrefix(line, "[IP]"))
			if ip == "error" {
				return "", fmt.Errorf("el script falló, revise el log: %s", out.String())
			}
			return ip, nil
		}
	}

	return "", fmt.Errorf("no se encontró la IP en la salida del script")
}

