// Función auxiliar para enviar respuesta JSON de error (centralizada)
func sendJSONError(w http.ResponseWriter, msg string, err error, statusCode int) {
	respuesta := map[string]interface{}{
		"exito":   false,
		"mensaje": fmt.Sprintf("%s: %v", msg, err),
	}
	w.Header().Set("Content-Type", "application/json")
	w.WriteHeader(statusCode)
	json.NewEncoder(w).Encode(respuesta)
}

