// Envía el nombre de host y IP al servidor DNS para agregar el registro A
func actualizarDNS(host, ip string) error {
	// ... (Tu código de actualización DNS, no modificado)
	key, err := os.ReadFile(privateKey)
	if err != nil {
		return fmt.Errorf("error leyendo clave privada: %v", err)
	}
	signer, err := ssh.ParsePrivateKey(key)
	if err != nil {
		return fmt.Errorf("error parseando clave privada: %v", err)
	}

	config := &ssh.ClientConfig{
		User:            dnsUser,
		Auth:            []ssh.AuthMethod{ssh.PublicKeys(signer)},
		HostKeyCallback: ssh.InsecureIgnoreHostKey(),
		Timeout:         15 * time.Second,
	}

	conn, err := ssh.Dial("tcp", dnsServerIP+":22", config)
	if err != nil {
		return fmt.Errorf("error conectando al servidor DNS: %v", err)
	}
	defer conn.Close()

	session, err := conn.NewSession()
	if err != nil {
		return fmt.Errorf("error creando sesión SSH: %v", err)
	}
	defer session.Close()

	cmd := fmt.Sprintf(`sudo bash /srv/scripts/dns_update.sh %s %s`, host, ip)
	out, err := session.CombinedOutput(cmd)
	if err != nil {
		return fmt.Errorf("error actualizando DNS: %v\nSalida: %s", err, string(out))
	}

	fmt.Println("Registro DNS actualizado:", string(out))
	return nil
}

// Envía y despliega el sitio ZIP en la máquina creada (Apache)
func desplegarSitio(ip, host, rutaZip string) error {
	// ... (Tu código de despliegue, no modificado)
	key, err := os.ReadFile(privateKey)
	if err != nil {
		return fmt.Errorf("error leyendo clave privada: %v", err)
	}
	signer, err := ssh.ParsePrivateKey(key)
	if err != nil {
		return fmt.Errorf("error parseando clave privada: %v", err)
	}

	// 🚨 ESTABLECER EL USUARIO CORRECTO AQUÍ
	const vmUser = "apachebase"

	config := &ssh.ClientConfig{
		User:            vmUser,
		Auth:            []ssh.AuthMethod{ssh.PublicKeys(signer)},
		HostKeyCallback: ssh.InsecureIgnoreHostKey(),
		Timeout:         30 * time.Second,
	}

	// 1️⃣ Subir ZIP
	// Nota: El usuario debian debe tener permisos de acceso por SSH y scp
	scpCmd := exec.Command("scp", "-i", privateKey, rutaZip, fmt.Sprintf("%s@%s:/tmp/sitio.zip", vmUser, ip))
	if out, err := scpCmd.CombinedOutput(); err != nil {
		return fmt.Errorf("error subiendo sitio (SCP): %v\n%s", err, string(out))
	}

	// 2️⃣ Conectarse y descomprimir
	conn, err := ssh.Dial("tcp", ip+":22", config)
	if err != nil {
		return fmt.Errorf("error conectando a la VM Apache (SSH): %v", err)
	}
	defer conn.Close()

	session, err := conn.NewSession()
	if err != nil {
		return fmt.Errorf("error creando sesión SSH: %v", err)
	}
	defer session.Close()

	cmd := fmt.Sprintf("sudo bash /usr/local/bin/deploy_site.sh %s", host)
	out, err := session.CombinedOutput(cmd)
	if err != nil {
		return fmt.Errorf("error desplegando sitio (SSH): %v\nSalida: %s", err, string(out))
	}

	fmt.Println("Sitio desplegado correctamente:", string(out))
	return nil
}

type RespuestaPublicacion struct {
	Exito   bool        `json:"exito"`
	Mensaje string      `json:"mensaje"`
	Datos   interface{} `json:"datos,omitempty"`
}

// ============================ HANDLERS HTTP ============================

func publicarHandler(w http.ResponseWriter, r *http.Request) {
	err := r.ParseMultipartForm(32 << 20)
	if err != nil {
		sendJSONError(w, "Error procesando formulario", err, http.StatusBadRequest)
		return
	}

	host := r.FormValue("host")
	ip := r.FormValue("ip") // ⬅️ CLAVE: RECUPERAMOS LA IP DEL FORMULARIO

	// Validación de parámetros
	if host == "" || ip == "" {
		sendJSONError(w, "Error de validación", fmt.Errorf("falta el host o la IP de la VM (paso anterior incompleto)"), http.StatusBadRequest)
		return
	}

	file, handler, err := r.FormFile("contenido")
	if err != nil {
		sendJSONError(w, "Error de archivo", fmt.Errorf("archivo ZIP no recibido"), http.StatusBadRequest)
		return
	}
	defer file.Close()

	// Guardar ZIP temporalmente
	tempDir := "./uploads/" + host
	os.MkdirAll(tempDir, os.ModePerm)
	rutaZip := filepath.Join(tempDir, handler.Filename)
	out, err := os.Create(rutaZip)
	if err != nil {
		sendJSONError(w, "Error de archivo", fmt.Errorf("no se pudo crear el archivo temporal"), http.StatusInternalServerError)
		return
	}
	io.Copy(out, file)
	out.Close()

	fmt.Println("[INFO] Despliegue iniciado en:", host, "IP:", ip)

	// 🚨 SE ELIMINA LA LLAMADA A crearMaquinaVirtual(host) AQUÍ

	// 2. Desplegar sitio (SCP + SSH)
	err = desplegarSitio(ip, host, rutaZip)
	if err != nil {
		// La máquina ya existe, pero el despliegue falló.
		sendJSONError(w, "Error desplegando sitio", err, http.StatusInternalServerError)
		return
	}

	time.Sleep(100 * time.Second) // Espera 2 segundos

	// 2. Actualizar DNS (por si falló en el paso de creación o si el flujo lo requiere aquí)
	// Si el DNS ya fue actualizado en /crear, esta llamada no hará daño.
	err = actualizarDNS(host, ip)
	if err != nil {
		sendJSONError(w, "Error actualizando DNS", err, http.StatusInternalServerError)
		return
	}

	// Respuesta de éxito
	instancia := Instancia{
		Host:  host,
		IP:    ip,
		URL:   fmt.Sprintf("http://%s/", ip),
		Fecha: time.Now().Format("2006-01-02 15:04:05"),
	}

	respuesta := RespuestaPublicacion{
		Exito:   true,
		Mensaje: "Sitio publicado correctamente",
		Datos:   &instancia,
	}

	w.Header().Set("Content-Type", "application/json; charset=utf-8")
	json.NewEncoder(w).Encode(respuesta) // Enviamos la estructura directamente
}

